    macros {
        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
            &kp F1                &kp F2         &kp F3        &kp F4        &kp F5                                                                                                                        &kp F6          &kp F7        &kp F8        &kp F9        &kp F10
            &kp EQUAL             &kp N1         &kp N2        &kp N3        &kp N4           &kp N5                                                                                               &kp N6  &kp N7          &kp N8        &kp N9        &kp N0         &kp MINUS
            &kp TAB               &kp Q          &kp W         &kp F         &kp P            &kp B                                                                                                &kp J   &kp L           &kp U         &kp Y         &kp SEMI       &kp BSLH
            &kp ESC               &hm LCTRL A    &hm LGUI R    &hm LALT S    &hm LSHIFT T     &kp G                                                                                                &kp M   &hm RSHIFT N    &hm RALT E    &hm RGUI I    &hm RCTRL O    &kp SQT
            &kp GRAVE             &kp Z          &kp X         &kp C         &kp D            &kp V    &mo LAYER_Keypad   &kp LCTRL         &lower    &lower     &kp RCTRL             &kp RSHFT   &kp K   &kp H           &kp COMMA     &kp DOT       &kp FSLH       &kp RSHIFT
            &magic LAYER_Magic 0  &kp HOME       &kp END       &kp LEFT      &kp RIGHT                 &kp BSPC           &td_corne_cw_nav  &kp LALT  &kp RALT   &lt LAYER_Lower ENTER   &kp SPACE           &kp UP          &kp DOWN      &kp LBKT      &kp RBKT       &kp PG_DN
            >;
        };

        game_layer {
            bindings = <
            &kp F1                &kp F2         &kp F3        &kp F4        &kp F5                                                                                                                    &kp F6        &kp F7       &kp F8        &kp F9        &kp F10
            &kp EQUAL             &kp N1         &kp N2        &kp N3        &kp N4           &kp N5                                                                                       &kp N6      &kp N7        &kp N8       &kp N9        &kp N0         &kp MINUS
            &hm LALT TAB          &kp Q          &kp W         &kp F         &kp P            &kp B                                                                                        &kp J       &kp L         &kp U        &kp Y         &kp SEMI       &kp BSLH
            &hm LCTRL ESC         &kp A          &kp R         &kp S         &hm LSHIFT T     &kp G                                                                                        &kp M       &hm RSHIFT N  &hm RALT E   &hm RGUI I    &hm RCTRL O    &kp SQT
            &kp LSHIFT            &kp Z          &kp X         &kp C         &kp D            &kp V    &mo LAYER_Keypad  &kp LCTRL  &lower    &lower    &kp RCTRL              &kp RSHFT   &kp K       &kp H         &kp COMMA    &kp DOT       &kp FSLH       &kp RSHIFT
            &magic LAYER_Magic 0  &kp HOME       &kp END       &kp LEFT      &kp RIGHT                 &kp BSPC          &kp SPACE  &kp LALT  &kp RALT  &lt LAYER_Lower ENTER  &kp SPACE               &kp UP        &kp DOWN     &kp LBKT      &kp RBKT       &kp PG_DN
            >;
        };
        
        keypad_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2 |  F3 |  F4  |  F5  |                                                               |  F6   |  F7   |  F8  |   F9  |  F10 |
            // |  =    |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |   -  |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                                                 |  Y   |   U   |   I   |  O   |   P   |   \  |
            // |  ESC  |  A  |  S  |  D   |  F   |  G   |                                                 |  H   |   J   |   K   |  L   |   ;   |   '  |
            // |   `   |  Z  |  X  |  C   |  V   |  B   | LSHFT | LCTRL | LOWER | | LGUI  | RCTRL | RSHFT |  N   |   M   |   ,   |  .   |   /   | PGUP |
            // | MAGIC | HOME| END | LEFT | RIGHT|      | BSPC  | DEL   | LALT  | | RALT  | RET   | SPACE |      |  UP   | DOWN  |  [   |   ]   | PGDN |

            bindings = <
            &kp F1                &kp F2         &kp F3        &kp F4        &kp F5                                                                                                  &kp F6           &kp F7          &kp F8          &kp F9          &kp F10
            &kp EQUAL             &kp N1         &kp N2        &kp N3        &kp N4           &kp N5                                                                       &kp N6    &kp N7           &kp N8          &kp N9          &kp N0         &kp MINUS
            &hm LALT TAB          &kp N1         &kp N2        &kp N3        &kp N4           &kp N5                                                                       &kp N6    &kp N7           &kp N8          &kp N9          &kp N0         &kp BSLH
            &hm LCTRL ESC         &kp DQT        &kp TILDE    &kp GRAVE      &hm LSHIFT LBRC  &kp LBKT                                                                     &kp RBKT  &hm RSHIFT RBRC  &hm RALT MINUS  &hm RGUI UNDER  &hm RCTRL SQT  &kp SQT
            &kp LSHIFT            &trans         &kp X         &trans        &kp PIPE         &kp BSLH   &trans    &kp LCTRL  &lower    &kp LGUI  &kp RCTRL  &kp RSHFT   &kp FSLH  &kp EQUAL        &kp COMMA       &kp DOT         &kp FSLH       &kp RSHIFT
            &magic LAYER_Magic 0  &kp HOME       &kp END       &kp LEFT      &kp RIGHT                   &kp BSPC  &kp SPACE  &kp LALT  &kp RALT  &kp RET    &kp SPACE             &kp UP           &kp DOWN        &kp LBKT        &kp RBKT       &kp PG_DN
            >;
        };
        
        lower_layer {
            bindings = <
            &kp C_BRI_DN      &kp C_BRI_UP        &kp C_PREV      &kp C_NEXT      &kp C_PP                                                                                                        &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP  &none         &kp PAUSE_BREAK
            &trans            &kp LG(N1)          &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)                                                                         &kp LG(N6)   &kp LG(N7)   &kp LG(N8)   &kp LG(N9)    &kp LG(N0)    &kp  PSCRN
            &trans            &none               &none           &kp UP          &none           &kp END                                                                            &kp DOWN     &kp RIGHT    &kp UP       &kp RIGHT     &kp PG_UP     &kp SLCK
            &trans            &none               &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_UP                                                                          &kp RIGHT    &kp LEFT     &kp HOME     &kp END       &kp PG_DN     &none
            &trans            &kp K_CMENU         &none           &kp F11         &kp F12         &kp PG_DN   &trans      &trans      &to LAYER_Base &trans      &trans      &trans  &kp UP       &kp LEFT     &kp KP_N2    &kp KP_N3     &kp KP_ENTER  &trans
            &trans            &kp CAPS            &kp INS         &kp F11         &kp F12                     &trans      &trans      &trans         &trans      &trans      &kp TAB              &kp KP_N0    &kp KP_N0    &kp KP_DOT    &kp KP_ENTER  &trans
            >;
        };

        magic_layer {
            bindings = <
            &bt BT_CLR        &none               &none           &none           &none                                                                                                           &to LAYER_Game      &to LAYER_Base      &none      &to LAYER_Base      &bt BT_CLR_ALL
            &none             &none               &none           &none           &none           &none                                                                                &none      &none               &none      &none      &none      &none
            &none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                      &none      &none               &none      &none      &none      &none
            &bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                      &none      &none               &none      &none      &none      &bootloader
            &sys_reset        &none               &none           &none           &none           &none           &bt_2     &bt_3     &none            &none     &none     &none       &none      &none               &none      &none      &none      &sys_reset
            &none             &none               &none           &none           &none                           &bt_0     &bt_1     &out OUT_USB     &none     &none     &none                  &none               &none      &none      &none      &to FACTORY_TEST
            >;
        };

        factory_test_layer {
            bindings = <
            &kp N0   &kp N6   &kp N2   &kp N8   &kp N4                                                                              &kp N4   &kp N8   &kp N2   &kp N6   &kp N0
            &kp N1   &kp N7   &kp N3   &kp N9   &kp N5   &kp N0                                                            &kp N0   &kp N5   &kp N9   &kp N3   &kp N7   &kp N1
            &kp N2   &kp N8   &kp N4   &kp N0   &kp N6   &kp N1                                                            &kp N1   &kp N6   &kp N0   &kp N4   &kp N8   &kp N2
            &kp N3   &kp N9   &kp N5   &kp N1   &kp N7   &kp N2                                                            &kp N2   &kp N7   &kp N1   &kp N5   &kp N9   &kp N3
            &kp N4   &kp N0   &kp N6   &kp N2   &kp N8   &kp N3   &kp N4   &kp N5   &kp N6      &kp N6   &kp N5   &kp N4   &kp N3   &kp N8   &kp N2   &kp N6   &kp N0   &kp N4
            &kp N5   &kp N1   &kp N7   &kp N3   &kp N9            &kp N7   &kp N8   &kp N9      &kp N9   &kp N8   &kp N7            &kp N9   &kp N3   &kp N7   &kp N1   &kp N5
            >;
        };
    };
};
